{
  "name": "qa-sdet-portfolio",
  "version": "0.1.0",
  "private": true,
  "description": "A lightweight static QA engineer portfolio for GitHub Pages.",
  "scripts": {
    "serve": "python3 -m http.server 4173",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "check": "npm run format:check && npm run lint && npm run test:e2e"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@eslint/js": "^9.36.0",
    "@playwright/test": "^1.58.2",
    "eslint": "^9.36.0",
    "globals": "^16.4.0",
    "prettier": "^3.6.2"
  }
}
