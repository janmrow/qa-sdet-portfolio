{
  "name": "qa-sdet-portfolio",
  "version": "0.1.0",
  "private": true,
  "description": "A lightweight static QA engineer portfolio for GitHub Pages.",
  "scripts": {
    "serve": "python3 -m http.server 4173",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:js": "eslint .",
    "lint:css": "stylelint \"assets/css/**/*.css\"",
    "lint:html": "htmlhint \"**/*.html\" --ignore \"node_modules/**,playwright-report/**,test-results/**\"",
    "lint": "npm run lint:js && npm run lint:css && npm run lint:html",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "check": "npm run format:check && npm run lint && npm run test:e2e",
    "prepare": "husky"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@eslint/js": "^9.36.0",
    "@playwright/test": "^1.58.2",
    "eslint": "^9.36.0",
    "globals": "^16.4.0",
    "htmlhint": "^1.1.4",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.6.2",
    "stylelint": "^16.2.0",
    "stylelint-config-standard": "^40.0.0"
  },
  "lint-staged": {
    "*.{js,cjs}": [
      "eslint",
      "prettier --write"
    ],
    "assets/css/**/*.css": [
      "stylelint",
      "prettier --write"
    ],
    "**/*.html": [
      "htmlhint",
      "prettier --write"
    ],
    "*.{md,json,yml}": [
      "prettier --write"
    ]
  }
}
